# =====================================================================
# Sports Intelligence AI — environment template
# Copy to .env:  cp .env.example .env
# Values below are safe local-development defaults (MOCK mode).
# Never commit the real .env.
# =====================================================================

# ----- Core ----------------------------------------------------------
# mock | sandbox | live_local
# mock: no external API keys required (offline, deterministic)
APP_ENV=mock
APP_TIMEZONE=Europe/Warsaw
LOG_LEVEL=INFO

# ----- Infrastructure -------------------------------------------------
# Host-side URLs (used by local tools outside Docker).
# Inside containers these are overridden by compose.yaml.
DATABASE_URL=postgresql+asyncpg://sports:sports_dev_password@localhost:5433/sports_intel
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# Postgres credentials used by the compose postgres service.
# Compose-only variables: ignored by the application Settings loader.
POSTGRES_USER=sports
POSTGRES_PASSWORD=sports_dev_password
POSTGRES_DB=sports_intel

# ----- Telegram (private bot, M3) ------------------------------------
# Required only for sandbox/live_local in later milestones.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs, e.g. 123456789,987654321
# (empty value = empty list; not JSON)
TELEGRAM_ALLOWED_USER_IDS=
# Base URL of the FastAPI control plane used by the bot.
# Inside Docker Compose this is overridden to http://sports-api:8000.
BOT_BACKEND_BASE_URL=http://localhost:8000

# ----- Sports data provider (M2) -------------------------------------
# mock = offline recorded responses (no key needed, CI-safe)
# api_football = real API-Football (requires SPORTS_API_KEY)
SPORTS_PROVIDER=mock
SPORTS_API_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
LEAGUES_CONFIG_PATH=config/leagues.yaml

# ----- Odds provider (M4) --------------------------------------------
ODDS_PROVIDER=
ODDS_API_KEY=

# ----- Search provider (M5) ------------------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ----- LLM (M7) --------------------------------------------------------
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
PREDICTOR_MODEL=
RESEARCH_MODEL=
IMPROVEMENT_MODEL=

# ----- Display/ranking defaults (provisional values) ------------------
DEFAULT_MIN_ODDS=1.30
DEFAULT_MIN_MODEL_PROBABILITY=0.55
DEFAULT_MIN_EDGE=0.05
